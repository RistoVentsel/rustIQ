RUSTIQ_POSTGRES_PASSWORD=replace-with-a-long-random-password

# Server discovery. Free key from https://steamcommunity.com/dev/apikey
# Without it the discovery worker stops and no new servers are found; everything
# else keeps working.
RUSTIQ_STEAM_API_KEY=
RUSTIQ_HTTP_PORT=5009
RUSTIQ_WEB_PORT=80
VITE_API_BASE_URL=/api
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Manual ad unit slot IDs from AdSense > Ads > By ad unit.
# Leave empty to serve Auto ads only; each configured slot adds one in-content
# unit on the matching pages.
VITE_ADSENSE_SLOT_SERVERS=
VITE_ADSENSE_SLOT_KNOWLEDGE=
VITE_ADSENSE_SLOT_MINIGAMES=
VITE_ADSENSE_SLOT_ARTICLE=
