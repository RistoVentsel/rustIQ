{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=rustiq;Username=rustiq;Password=rustiq_dev_password"
  },
  "RustServerQuery": {
    "TimeoutMilliseconds": 3000,
    "OfflineThresholdSeconds": 60,
    "Servers": []
  },
  "RustServerCatalogImport": {
    "Enabled": false,
    "JsonFilePath": "backend/config/rust-servers.import.json"
  },
  "SteamDiscovery": {
    "Enabled": true,
    "Host": "hl2master.steampowered.com",
    "Port": 27011,
    "TimeoutMilliseconds": 5000,
    "MaxServersPerRefresh": 1000,
    "RefreshIntervalMinutes": 10,
    "Filter": "\\appid\\252490",
    "AllowBattleMetricsFallback": true,
    "FallbackMasterServers": [
      "208.64.200.65:27015"
    ]
  },
  "BattleMetricsDiscovery": {
    "Enabled": true,
    "PageSize": 100,
    "MaxPages": 35,
    "RefreshIntervalMinutes": 10
  },
  "BattleMetricsSummaryRefresh": {
    "Enabled": true,
    "BatchSize": 25,
    "RefreshIntervalSeconds": 120,
    "StaleAfterSeconds": 300,
    "RefreshCurrentPlayers": false,
    "RefreshMapMetadata": false
  },
  "SnapshotRetention": {
    "Enabled": true,
    "RetentionDays": 14,
    "CleanupIntervalHours": 12
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
