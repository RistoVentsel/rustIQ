{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=rustiq;Username=rustiq;Password=rustiq_dev_password"
  },
  "RustServerQuery": {
    "TimeoutMilliseconds": 3000,
    "OfflineThresholdSeconds": 600,
    "WatchedOfflineThresholdSeconds": 60,
    "Servers": []
  },
  "RustServerCatalogImport": {
    "Enabled": false,
    "JsonFilePath": "backend/config/rust-servers.import.json"
  },
  "BattleMetricsApi": {
    "Enabled": false,
    "MinimumRequestIntervalMilliseconds": 1100
  },
  "BattleMetricsWipeFallback": {
    "Enabled": true,
    "RequestTimeoutSeconds": 20
  },
  "SteamDiscovery": {
    "Enabled": false,
    "ApiKey": "",
    "TimeoutMilliseconds": 30000,
    "MaxServersPerRefresh": 5000,
    "RefreshIntervalMinutes": 10,
    "Filter": "\\appid\\252490",
    "AllowBattleMetricsFallback": true
  },
  "BattleMetricsDiscovery": {
    "Enabled": true,
    "PageSize": 100,
    "MaxPages": 60,
    "RefreshIntervalMinutes": 10
  },
  "BattleMetricsSummaryRefresh": {
    "Enabled": true,
    "WorkerTickSeconds": 15,
    "RefreshConcurrency": 16,
    "DirectoryRefreshIntervalMinutes": 3,
    "FastLaneRefreshIntervalSeconds": 45,
    "NormalOnlineRefreshIntervalMinutes": 3,
    "SlowOfflineRefreshIntervalMinutes": 20,
    "VeryStaleOfflineRefreshIntervalMinutes": 60,
    "PopularOfflineGraceMinutes": 60,
    "SlowOfflineAfterMinutes": 60,
    "VeryStaleOfflineAfterHours": 24,
    "PopularRankThreshold": 250,
    "PopularPlayerThreshold": 100,
    "PopularPeakPlayerThreshold": 100,
    "RecentPeakWindowMinutes": 60,
    "FastLaneBatchSize": 50,
    "NormalOnlineLaneBatchSize": 100,
    "SlowOfflineLaneBatchSize": 100,
    "VeryStaleOfflineLaneBatchSize": 100,
    "SnapshotIntervalMinutes": 30,
    "RefreshCurrentPlayers": false,
    "RefreshMapMetadata": false
  },
  "MapMetadataRefresh": {
    "Enabled": false,
    "RunOnStartup": true,
    "StartupStaleAfterHours": 8,
    "TimeZoneId": "Europe/Tallinn",
    "LocalHours": [
      3,
      18,
      22
    ],
    "MaxServersPerRun": 1000,
    "BatchSize": 25,
    "DelayBetweenServersMilliseconds": 0,
    "DelayBetweenBatchesSeconds": 1
  },
  "SnapshotRetention": {
    "Enabled": true,
    "RetentionDays": 14,
    "CleanupIntervalHours": 12,
    "UnreachableServerRetentionDays": 30,
    "MaxUnreachableServerDeletesPerRun": 5000
  },
  "ServerRanking": {
    "Enabled": true,
    "MaxRankedServers": 250,
    "RankingWindowDays": 7,
    "RefreshIntervalHours": 1,
    "MinimumSnapshots": 6,
    "RecentOnlineWindowHours": 24,
    "MinimumMaxPlayers": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
